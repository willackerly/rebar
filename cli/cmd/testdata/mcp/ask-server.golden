GET /v1/health 
200 {
  "status": "ok",
  "repos": 3
}
GET /v1/agents 
200 [
  {
    "repo": "dsp_2_8",
    "role": "steward",
    "id": "dsp_2_8:steward"
  },
  {
    "repo": "skipme",
    "role": "architect",
    "id": "skipme:architect"
  },
  {
    "repo": "web",
    "role": "architect",
    "id": "web:architect"
  },
  {
    "repo": "web",
    "role": "broken",
    "id": "web:broken"
  },
  {
    "repo": "web",
    "role": "custom",
    "id": "web:custom"
  },
  {
    "repo": "web",
    "role": "empty",
    "id": "web:empty"
  },
  {
    "repo": "web",
    "role": "product",
    "id": "web:product"
  }
]
GET /v1/repos/ 
200 [
  {
    "repo": "dsp_2_8",
    "path": "$REPOS/group/dsp_2_8",
    "agents": [
      "steward"
    ]
  },
  {
    "repo": "skipme",
    "path": "$REPOS/skipme",
    "agents": [
      "architect"
    ]
  },
  {
    "repo": "web",
    "path": "$REPOS/web",
    "agents": [
      "architect",
      "broken",
      "custom",
      "empty",
      "product"
    ]
  }
]
GET /v1/status/web/architect 
200 {
  "repo": "web",
  "role": "architect",
  "status": "stopped",
  "key with space": "v:2"
}
GET /v1/status/web/ghost 
404 {"error": "Agent 'ghost' not found in repo 'web'"}
GET /v1/status/nope/architect 
404 {"error": "Repo 'nope' not found"}
GET /v1/status/web 
404 {"error": "Expected /v1/status/<repo>/<role>"}
GET /v1/log/web/product 
200 {
  "repo": "web",
  "role": "product",
  "log": "---\n**2026-01-01T00:00:00Z** Q: hi\nA: hello\n"
}
GET /v1/log/web/architect 
200 {
  "repo": "web",
  "role": "architect",
  "log": "(no log entries yet)"
}
GET /v1/log/web/architect/extra 
404 {"error": "Expected /v1/log/<repo>/<role>"}
POST /v1/ask {"repo":"web","role":"architect","question":"Why?"}
200 {
  "repo": "web",
  "role": "architect",
  "answer": "answer from web: architect Why?",
  "exit_code": 0,
  "error": null
}
POST /v1/ask {"repo":"web","role":"product","question":"Who?","verbose":1}
200 {
  "repo": "web",
  "role": "product",
  "answer": "answer from web: -v product Who?",
  "exit_code": 0,
  "error": null
}
POST /v1/ask {"repo":"web","role":"broken","question":"q"}
200 {
  "repo": "web",
  "role": "broken",
  "answer": "partial output",
  "exit_code": 3,
  "error": "ask: error: claude invocation failed"
}
POST /v1/ask {"repo":"nope","role":"architect","question":"q"}
404 {"error": "Repo 'nope' not found. Use GET /v1/repos to list available repos."}
POST /v1/ask {"repo":"web","role":"ghost","question":"q"}
404 {"error": "Agent 'ghost' not found in repo 'web'. Use GET /v1/agents to list available agents."}
POST /v1/ask {"repo":"web","role":"architect","question":"  "}
400 {"error": "Required fields: repo, role, question"}
POST /v1/ask {bad
400 {"error": "Invalid JSON: invalid character 'b' looking for beginning of object key string"}
POST /v1/reset/web/architect 
200 {
  "repo": "web",
  "role": "architect",
  "message": "Session cleared for architect (was: abc)"
}
POST /v1/reset/web 
404 {"error": "Expected /v1/reset/<repo>/<role>"}
POST /v1/nothing 
404 {"error": "Not found"}
GET /elsewhere 
404 {"error": "Not found"}
