g", "description": "Question to ask the agent"}, "verbose": {"type": "boolean", "description": "Request verbose response with rationale", "default": false}}, "required": ["question"]}}, {"name": "ask_web_empty", "description": "Query the empty agent for web.", "inputSchema": {"type": "object", "properties": {"question": {"type": "string", "description": "Question to ask the agent"}, "verbose": {"type": "boolean", "description": "Request verbose response with rationale", "default": false}}, "required": ["question"]}}, {"name": "ask_web_product", "description": "Product agent for web. Owns user personas, requirements, priorities, and scope decisions. Best for: 'who is this for?', 'what does success look like?', 'does this match user needs?', and forward-from-intent reasoning. Repo specifics: Owns personas for the web app.", "inputSchema": {"type": "object", "properties": {"question": {"type": "string", "description": "Question to ask the agent"}, "verbose": {"type": "boolean", "description": "Request verbose response with rationale", "default": false}}, "required": ["question"]}}]}}
