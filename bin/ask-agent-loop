#!/bin/sh
# ask-agent-loop — ASK's standalone agent loop, for use as an agent's run.sh, built into the rebar binary.
# CONTRACT:S2-ASK-CLI.1.0
#
# Shim: runs `rebar ask-agent-loop` with the same arguments — the rebar beside this
# script (through symlinks) if it runs on this machine, else REBAR_BIN, else
# the one on PATH — so PATH entries, .mcp.json files and scripts naming bin/ask-agent-loop keep working.
# REBAR_ASK_HANDOFF is set for the rebar it runs: a rebar older than 4.0,
# whose `rebar ask` runs this script, would otherwise loop.
if [ -n "${REBAR_ASK_HANDOFF:-}" ]; then
  echo "ask-agent-loop: this rebar has no built-in ASK (it ran ask-agent-loop back); install rebar 4.0 or later" >&2
  exit 127
fi
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
rebar=$(dirname "$self")/rebar
# The rebar beside this script may be built for another platform (a git
# checkout's bin/rebar is one platform's build): use it only if it runs.
if [ ! -x "$rebar" ] || ! "$rebar" --version >/dev/null 2>&1; then
  rebar=${REBAR_BIN:-}
fi
if [ -z "$rebar" ] || [ ! -x "$rebar" ]; then
  rebar=$(command -v rebar 2>/dev/null) || {
    echo "ask-agent-loop: the rebar binary was not found (beside this script, REBAR_BIN or PATH)" >&2
    exit 127
  }
fi
REBAR_ASK_HANDOFF=1 exec "$rebar" ask-agent-loop "$@"
