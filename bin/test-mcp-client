#!/bin/sh
# test-mcp-client — a demo client for an HTTP MCP server, built into the rebar binary.
#
# Hand-off: runs `rebar mcp client` with the same arguments — the rebar beside
# this script (through symlinks), else REBAR_BIN, else the one on PATH — so
# .mcp.json files and scripts naming bin/test-mcp-client keep working.
# REBAR_CHECK_IMPL=shell runs the python original, bin/legacy/test-mcp-client.py,
# until it is removed.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
dir=$(dirname "$self")
if [ "${REBAR_CHECK_IMPL:-}" = shell ]; then
  exec python3 "$dir/legacy/test-mcp-client.py" "$@"
fi
rebar=$dir/rebar
[ -x "$rebar" ] || rebar=${REBAR_BIN:-}
if [ -z "$rebar" ] || [ ! -x "$rebar" ]; then
  rebar=$(command -v rebar 2>/dev/null) || {
    echo "test-mcp-client: the rebar binary was not found (beside this script, REBAR_BIN or PATH)" >&2
    exit 127
  }
fi
exec "$rebar" mcp client "$@"
